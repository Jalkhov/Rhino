// Rhino — maqueta de la interfaz (Fase 4).
//
// Anclada en la interfaz real de Avira Free Security (medida en
// docs/referencias/avira-free-security.png): superficies planas, azul naval, un
// solo acento azul, verde para "está bien", ámbar para lo que falta y minúsculas
// corrientes en los rótulos. Nada de mayúsculas grabadas, filetes de latón ni
// agujas de dial.
//
// Regla de color: el rojo marca "aquí hay algo que te importa" y solo aparece en
// los hallazgos (punto, filete, distintivo). Ningún botón es rojo.
//
// Regla de densidad, que manda sobre todo lo demás: **una pantalla dice una cosa y
// ofrece una acción**. Un usuario poco técnico no debe tener que elegir dónde
// mirar. Todo lo que no ayude a decidir se va a la pantalla que le toca.
//
// «Poner a salvo» e «Historial» leen del disco. Solo «Ajustes» sigue siendo
// maqueta (`demo`), y la tira MAQUETA · ESTADO existe únicamente en desarrollo.

// La tipografía va incrustada: la interfaz no depende de las fuentes del sistema, y
// las de Windows no miden como las de Linux. Inter (SIL OFL 1.1) en los tres pesos que
// usa la maqueta; el aviso está en fonts/INTER-LICENSE.txt. Se usan los TTF estáticos y
// no el variable: Slint indexa por familia y peso y el variable se quedaría en el 400.
import "./fonts/Inter-Regular.ttf";
import "./fonts/Inter-SemiBold.ttf";
import "./fonts/Inter-Bold.ttf";
import { Theme } from "theme.slint";
import { Icon, Icons } from "icon.slint";

// Un hallazgo tal como lo ve la lista de «Archivos sospechosos». La autoría de la
// regla viaja aparte del motivo porque la licencia DRL 1.1 obliga a mostrarla.
export struct FindingItem {
    name: string,
    path: string,
    level: string,        // "PELIGROSO" o "SOSPECHOSO"
    reason: string,
    rule-id: string,
    rule-author: string,
    rule-source: string,
}

// Un archivo apartado, tal como lo ve «Poner a salvo». `where` es la carpeta de
// donde salió («Descargas»), no la ruta entera.
export struct SafeItem {
    name: string,
    path: string,
    where: string,
    when: string,         // DD-MM-YYYY HH:mm, en hora local
    sha256: string,
}

// Un análisis terminado, tal como lo ve «Historial». `files` llega ya con el
// separador de millares puesto.
export struct HistoryItem {
    when: string,         // DD-MM-YYYY HH:mm, en hora local
    scope: string,
    files: string,
    findings: int,
}

// ── Piezas ────────────────────────────────────────────────────────────────────

component Rule inherits Rectangle {
    height: 1px;
    background: Theme.rule;
}

// Centra verticalmente una pieza de tamaño fijo (un icono, un distintivo, una
// lámpara, un botón) dentro de una fila. Una fila NO centra sola: pega al inicio
// lo que no puede estirar.
component Mid inherits VerticalLayout {
    alignment: center;
    @children
}

// Botón. Lo que se pulsa es azul; lo secundario, un relleno neutro; lo terciario,
// texto con filete. Todo lo que no es el principal lleva filete, para que se lea
// como un control sobre la tarjeta. Lo deshabilitado NO se aclara con opacidad (eso
// apaga también el filete): cambia a tinta apagada sobre el mismo relleno.
component AppButton inherits Rectangle {
    in property <string> label;
    in property <string> glyph: "";
    in property <bool> primary: true;
    in property <bool> quiet: false;
    in property <bool> enabled: true;
    callback clicked;

    height: 38px;
    border-radius: Theme.r-sm;
    // Ojo con el orden: `primary` es true por defecto, así que `quiet` se comprueba
    // ANTES. Al revés, todo botón que solo pidiera `quiet` salía azul.
    background: !root.enabled ? Theme.control
              : root.quiet ? (touch.has-hover ? Theme.control : transparent)
              : root.primary ? (touch.has-hover ? Theme.accent-deep : Theme.accent)
              : (touch.has-hover ? Theme.control-hover : Theme.control);
    border-width: root.primary && !root.quiet ? 0px : 1px;
    border-color: Theme.rule;

    HorizontalLayout {
        alignment: center;
        padding-left: 18px;
        padding-right: 18px;
        spacing: 8px;

        if root.glyph != "" : Mid {
            Icon {
                glyph: root.glyph;
                box: 16px;
                tint: root.enabled ? Theme.ink : Theme.ink-off;
            }
        }

        Text {
            text: root.label;
            font-size: Theme.t-md;
            font-weight: 600;
            color: !root.enabled ? Theme.ink-off : (root.quiet ? Theme.ink-soft : Theme.ink);
            vertical-alignment: center; // sin esto la etiqueta se pega al borde de arriba
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { if root.enabled { root.clicked(); } }
    }
}

// Tarjeta. Título en blanco y contenido debajo.
component Panel inherits Rectangle {
    in property <string> title: "";

    background: Theme.card;
    border-radius: Theme.r-md;

    VerticalLayout {
        padding: 18px;
        spacing: 12px;

        if root.title != "" : Text {
            text: root.title;
            font-size: Theme.t-lg;
            font-weight: 600;
            color: Theme.ink;
        }

        @children
    }
}

// Insignia de estado: relleno saturado con texto encima. Es la forma más legible
// de decir "peligroso" sobre una superficie oscura.
component Badge inherits Rectangle {
    in property <string> label;
    in property <color> tone: Theme.danger-fill;

    height: 22px;
    border-radius: Theme.r-pill;
    background: root.tone;

    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        alignment: center;

        Text {
            text: root.label;
            font-size: Theme.t-xs;
            font-weight: 700;
            color: root.tone == Theme.warn ? Theme.rail : Theme.ink;
            vertical-alignment: center;
        }
    }
}

// Fila del riel. La activa se rellena de azul a todo el ancho, como en Avira.
component NavRow inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> current: false;
    in property <string> badge: "";
    callback clicked;

    height: 38px;
    background: root.current ? Theme.accent : (touch.has-hover ? #242E35 : transparent);

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 10px;

        Mid {
            Icon {
                glyph: root.glyph;
                box: 17px;
                tint: root.current ? Theme.ink : Theme.ink-soft;
            }
        }

        Text {
            text: root.label;
            font-size: Theme.t-md;
            color: root.current ? Theme.ink : Theme.ink-soft;
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.badge != "" : Mid {
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                background: Theme.danger-fill;

                Text {
                    text: root.badge;
                    font-size: Theme.t-xs;
                    font-weight: 700;
                    color: Theme.ink;
                    width: parent.width;
                    height: parent.height;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// La tarjeta de estado de Avira: un círculo con un visto, un titular y una
// explicación. Es lo primero y casi lo único que se ve en Inicio.
component StatusCard inherits Rectangle {
    in property <color> tone: Theme.ok;
    in property <string> glyph: Icons.check;
    in property <string> headline;
    in property <string> message;

    VerticalLayout {
        alignment: center;
        spacing: 14px;

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 60px;
                height: 60px;
                border-radius: 30px;
                background: root.tone;

                Icon {
                    glyph: root.glyph;
                    box: 30px;
                    tint: #FFFFFF;
                    x: (parent.width - 30px) / 2;
                    y: (parent.height - 30px) / 2;
                }
            }
        }

        Text {
            text: root.headline;
            font-size: Theme.t-2xl;
            font-weight: 600;
            color: Theme.ink;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Text {
            text: root.message;
            font-size: Theme.t-md;
            color: Theme.ink-soft;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

// Una opción de análisis. La elegida se marca con el acento, no con otro color.
component ScopeCard inherits Rectangle {
    in property <string> glyph;
    in property <string> title;
    in property <string> hint;
    in property <bool> current: false;
    callback clicked;

    height: 104px;
    border-radius: Theme.r-md;
    // La elegida NO cambia de relleno: se marca con el borde y con el círculo de
    // la derecha. Teñir la tarjeta de azul la convertía en un campo de texto
    // enfocado, y eso no es lo que está pasando aquí.
    background: touch.has-hover ? #414A53 : Theme.card;
    border-width: 2px;
    border-color: root.current ? Theme.accent-mark : transparent;

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 14px;

        Mid {
            Icon {
                glyph: root.glyph;
                box: 26px;
                tint: root.current ? Theme.ink : Theme.ink-soft;
            }
        }

        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 1;
            alignment: center;

            Text {
                text: root.title;
                font-size: Theme.t-lg;
                font-weight: 600;
                color: Theme.ink;
            }

            Text {
                text: root.hint;
                font-size: Theme.t-sm;
                color: Theme.ink-muted;
                wrap: word-wrap;
            }
        }

        // Un círculo con punto: el idioma de "elige una de estas" que cualquiera
        // reconoce sin que haya que explicarlo.
        Mid {
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                border-width: 2px;
                border-color: root.current ? Theme.accent-mark : Theme.ink-muted;
                background: transparent;

                Rectangle {
                    visible: root.current;
                    x: 5px;
                    y: 5px;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: Theme.accent-mark;
                }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ── Filas de datos ────────────────────────────────────────────────────────────

// Un hallazgo: lámpara, nombre, motivo plegado y una sola acción que importa.
component FindingRow inherits Rectangle {
    in property <string> name;
    in property <string> path;
    in property <string> level: "PELIGROSO";
    in property <string> reason;
    in property <string> rule-id;
    in property <string> rule-author;
    in property <string> rule-source;
    in property <bool> expanded: false;
    callback toggle;
    callback quarantine;
    callback ignore;

    background: Theme.card;
    border-radius: Theme.r-md;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 12px;

            Mid {
                Rectangle {
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: root.level == "PELIGROSO" ? Theme.danger : Theme.warn;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;

                Text {
                    text: root.name;
                    font-size: Theme.t-lg;
                    font-weight: 600;
                    color: Theme.ink;
                    overflow: elide;
                }
            }

            Mid {
                Badge {
                    label: root.level;
                    tone: root.level == "PELIGROSO" ? Theme.danger-fill : Theme.warn;
                }
            }

            Mid {
                HorizontalLayout {
                    spacing: 10px;

                    AppButton {
                        width: 146px;
                        label: "Poner a salvo";
                        clicked => { root.quarantine(); }
                    }

                    AppButton {
                        width: 104px;
                        quiet: true;
                        label: "Ignorar";
                        clicked => { root.ignore(); }
                    }
                }
            }
        }

        // La ruta va en su propia linea y a todo el ancho: compartiendo fila con la
        // insignia y los dos botones se cortaba con puntos suspensivos.
        Text {
            text: root.path;
            font-size: Theme.t-xs;
            color: Theme.ink-muted;
            overflow: elide;
        }

        Text {
            text: root.reason;
            font-size: Theme.t-sm;
            color: Theme.ink-soft;
            wrap: word-wrap;
        }

        AppButton {
            width: 216px;
            height: 32px;
            quiet: true;
            label: root.expanded ? "Ocultar la comprobación" : "Ver la comprobación";
            clicked => { root.toggle(); }
        }

        if root.expanded : Rectangle {
            background: Theme.sunken;
            border-radius: Theme.r-sm;

            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 12px;
                    Text { text: "Comprobación"; font-size: Theme.t-sm; color: Theme.ink-muted; width: 104px; }
                    Text { text: root.rule-id; font-size: Theme.t-sm; color: Theme.ink-soft; horizontal-stretch: 1; overflow: elide; }
                }

                HorizontalLayout {
                    spacing: 12px;
                    Text { text: "Autor"; font-size: Theme.t-sm; color: Theme.ink-muted; width: 104px; }
                    Text { text: root.rule-author; font-size: Theme.t-sm; color: Theme.ink-soft; horizontal-stretch: 1; overflow: elide; }
                }

                HorizontalLayout {
                    spacing: 12px;
                    Text { text: "Origen"; font-size: Theme.t-sm; color: Theme.ink-muted; width: 104px; }
                    Text { text: root.rule-source; font-size: Theme.t-sm; color: Theme.ink-soft; horizontal-stretch: 1; overflow: elide; }
                }
            }
        }
    }
}

// Un archivo apartado.
component SafeRow inherits Rectangle {
    in property <string> name;
    in property <string> where;
    in property <string> when;
    callback restore;
    callback erase;

    height: 64px;
    background: Theme.card;
    border-radius: Theme.r-md;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;

        Mid {
            Icon { glyph: Icons.archive; box: 18px; tint: Theme.ink-soft; }
        }

        VerticalLayout {
            spacing: 3px;
            horizontal-stretch: 1;
            alignment: center;

            Text { text: root.name; font-size: Theme.t-md; color: Theme.ink; overflow: elide; }
            Text { text: root.where + " · apartado el " + root.when; font-size: Theme.t-xs; color: Theme.ink-muted; overflow: elide; }
        }

        Mid {
            HorizontalLayout {
                spacing: 10px;

                AppButton {
                    width: 150px;
                    glyph: Icons.rotate;
                    label: "Recuperar";
                    clicked => { root.restore(); }
                }

                AppButton {
                    width: 96px;
                    quiet: true;
                    label: "Borrar";
                    clicked => { root.erase(); }
                }
            }
        }
    }
}

// ── Pantallas ─────────────────────────────────────────────────────────────────

// Inicio: el estado del equipo, dicho en una frase, y una sola acción que hacer.
component HomeScreen inherits Rectangle {
    in property <string> headline;
    in property <string> message;
    in property <color> tone;
    in property <string> glyph;
    in property <string> action;
    callback act;

    VerticalLayout {
        alignment: center;
        padding-left: 56px;
        padding-right: 56px;
        spacing: 26px;

        StatusCard {
            tone: root.tone;
            glyph: root.glyph;
            headline: root.headline;
            message: root.message;
        }

        HorizontalLayout {
            alignment: center;

            AppButton {
                width: 280px;
                height: 44px;
                label: root.action;
                clicked => { root.act(); }
            }
        }
    }
}

// Analizar: se elige una cosa y se pulsa un botón. Mientras analiza, enseña lo que
// de verdad está pasando (cuántos archivos y cuál) y deja detenerlo. No hay barra
// determinada: cuántos archivos hay no se sabe hasta recorrerlos.
component AnalyzeScreen inherits Rectangle {
    in property <bool> scanning: false;
    in property <int> scanned: 0;
    in property <int> failed: 0;
    in property <string> current-file: "";
    in property <string> chosen-path;
    in-out property <int> scope: 0;
    callback scan-all();
    callback pick-folder();
    callback pick-file();
    callback cancel-scan();

    // Lo que no se pudo leer se dice solo cuando hay algo que decir.
    property <string> failures: root.failed == 0 ? ""
        : (root.failed == 1 ? " · 1 no se pudo leer"
            : " · " + root.failed + " no se pudieron leer");

    VerticalLayout {
        padding: 28px;
        spacing: 16px;

        if !root.scanning : Text {
            text: "¿Qué quieres analizar?";
            font-size: Theme.t-lg;
            color: Theme.ink-soft;
        }

        if !root.scanning : HorizontalLayout {
            height: 104px;
            spacing: 14px;

            ScopeCard {
                horizontal-stretch: 1;
                glyph: Icons.monitor;
                title: "Todo el equipo";
                hint: "Discos completos";
                current: root.scope == 0;
                clicked => { root.scope = 0; }
            }

            ScopeCard {
                horizontal-stretch: 1;
                glyph: Icons.folder;
                title: "Una carpeta";
                hint: "Lo que haya dentro";
                current: root.scope == 1;
                clicked => { root.scope = 1; }
            }

            ScopeCard {
                horizontal-stretch: 1;
                glyph: Icons.file;
                title: "Un archivo";
                hint: "Solo uno";
                current: root.scope == 2;
                clicked => { root.scope = 2; }
            }
        }

        if !root.scanning && root.scope != 0 : Rectangle {
            height: 46px;
            background: Theme.sunken;
            border-radius: Theme.r-sm;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 8px;
                spacing: 12px;

                Mid {
                    Icon {
                        glyph: root.scope == 1 ? Icons.folder-open : Icons.file;
                        box: 16px;
                        tint: Theme.ink-soft;
                    }
                }

                Text {
                    text: root.chosen-path == "" ? "Todavía no has elegido nada" : root.chosen-path;
                    font-size: Theme.t-sm;
                    color: root.chosen-path == "" ? Theme.ink-muted : Theme.ink;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Mid {
                    AppButton {
                        width: 190px;
                        label: "Elegir con Windows";
                        clicked => {
                            if root.scope == 1 { root.pick-folder(); }
                            else { root.pick-file(); }
                        }
                    }
                }
            }
        }

        if root.scanning : Rectangle {
            background: Theme.card;
            border-radius: Theme.r-md;
            // Sin esto el panel se reparte el sobrante con el espaciador final y
            // lo absorben sus textos, que quedan separados por huecos enormes.
            vertical-stretch: 0;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                Text { text: "Analizando"; font-size: Theme.t-lg; font-weight: 600; color: Theme.ink; }

                Text {
                    text: root.current-file == ""
                        ? "Preparando el análisis…"
                        : "Ahora mismo: " + root.current-file;
                    font-size: Theme.t-sm;
                    color: Theme.ink-soft;
                    overflow: elide;
                }

                Text {
                    text: (root.scanned == 1 ? "1 archivo mirado" : root.scanned + " archivos mirados") + root.failures;
                    font-size: Theme.t-sm;
                    color: Theme.ink-muted;
                    overflow: elide;
                }

                HorizontalLayout {
                    alignment: center;

                    AppButton {
                        width: 132px;
                        primary: false;
                        label: "Detener";
                        clicked => { root.cancel-scan(); }
                    }
                }
            }
        }

        if !root.scanning : VerticalLayout {
            alignment: center;
            spacing: 10px;

            // El botón tiene ancho fijo: quien lo centra es la fila que lo envuelve,
            // porque `alignment` solo actúa sobre el eje principal del layout.
            HorizontalLayout {
                alignment: center;

                AppButton {
                    width: 268px;
                    height: 44px;
                    label: root.scope == 0 ? "Analizar todo el equipo"
                         : (root.scope == 1 ? "Analizar esa carpeta" : "Analizar ese archivo");
                    clicked => {
                        if root.scope == 0 { root.scan-all(); }
                        else if root.scope == 1 { root.pick-folder(); }
                        else { root.pick-file(); }
                    }
                }
            }

            Text {
                text: "Puedes seguir usando el equipo mientras analizamos.";
                font-size: Theme.t-sm;
                color: Theme.ink-muted;
                horizontal-alignment: center;
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
}

// Los hallazgos: qué se encontró y qué se puede hacer.
component ResultsScreen inherits Rectangle {
    in property <[FindingItem]> findings;
    in property <string> headline;
    in-out property <int> expanded: -1;
    callback go(int);
    callback quarantine(int);
    callback ignore(int);

    VerticalLayout {
        padding: 28px;
        spacing: 16px;

        Text {
            text: root.headline;
            font-size: Theme.t-xl;
            font-weight: 600;
            color: Theme.ink;
            overflow: elide;
        }

        // La lista puede ser larga: un análisis de verdad deja decenas de filas
        // y la ventana mide 680 px fijos, así que la lista se desplaza.
        if root.findings.length > 0 : scroll := Flickable {
            // Ancho explícito: si lo deja al contenido, la cadena resuelve por el
            // tamaño de la tarjeta y la lista se encoge (regla 1).
            width: root.width - 56px;
            vertical-stretch: 1;
            content-width: scroll.width;
            content-height: list.preferred-height;
            interactive: true;

            list := VerticalLayout {
                width: scroll.width;
                spacing: 16px;

                for finding[index] in root.findings : FindingRow {
                    name: finding.name;
                    path: finding.path;
                    level: finding.level;
                    reason: finding.reason;
                    rule-id: finding.rule-id;
                    rule-author: finding.rule-author;
                    rule-source: finding.rule-source;
                    expanded: root.expanded == index;
                    toggle => { root.expanded = root.expanded == index ? -1 : index; }
                    quarantine => { root.quarantine(index); }
                    ignore => { root.ignore(index); }
                }
            }
        }

        // El mismo estado vacío que el de «Poner a salvo», envuelto para que el
        // sobrante lo absorba el envoltorio y no la tarjeta (regla 17).
        if root.findings.length == 0 : VerticalLayout {
            vertical-stretch: 1;
            alignment: center;

            Rectangle {
                background: Theme.card;
                border-radius: Theme.r-md;

                VerticalLayout {
                    alignment: center;
                    spacing: 12px;
                    padding: 24px;

                    HorizontalLayout {
                        alignment: center;
                        Icon { glyph: Icons.check-circle; box: 34px; tint: Theme.ink-muted; }
                    }

                    Text {
                        text: "No hay nada sospechoso";
                        font-size: Theme.t-xl;
                        font-weight: 600;
                        color: Theme.ink;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "Lo que encontremos aparecerá aquí, con lo que puedes hacer con ello.";
                        font-size: Theme.t-md;
                        color: Theme.ink-muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        alignment: center;

                        AppButton {
                            width: 180px;
                            label: "Volver a Inicio";
                            clicked => { root.go(0); }
                        }
                    }
                }
            }
        }
    }
}

// Poner a salvo: lo apartado, y nada más.
component SafeScreen inherits Rectangle {
    in property <[SafeItem]> items;
    in property <string> problem: "";
    callback go(int);
    callback restore(int);
    callback erase(int);

    VerticalLayout {
        padding: 28px;
        spacing: 12px;

        // La lista puede crecer: la ventana mide 680 px fijos y lo apartado no
        // tiene tope, así que se desplaza como la de hallazgos.
        // El envoltorio se queda el sobrante y el Flickable lo llena: un Flickable
        // suelto en el layout mide lo que mide su contenido y no se desplaza.
        if root.items.length > 0 : Rectangle {
            vertical-stretch: 1;

            scroll := Flickable {
                width: parent.width;
                height: parent.height;
                content-width: self.width;
                content-height: rows.preferred-height;
                interactive: true;

                rows := VerticalLayout {
                    width: scroll.width;
                    spacing: 10px;

                    for item[index] in root.items : SafeRow {
                        name: item.name;
                        where: item.where;
                        when: item.when;
                        restore => { root.restore(index); }
                        erase => { root.erase(index); }
                    }
                }
            }
        }

        // El envoltorio se queda el sobrante: si no, la tarjeta lo comparte con el
        // pie y crece hasta llenar la pantalla para decir dos lineas.
        if root.items.length == 0 : VerticalLayout {
            vertical-stretch: 1;
            alignment: center;

            Rectangle {
                background: Theme.card;
                border-radius: Theme.r-md;

                VerticalLayout {
                    alignment: center;
                    spacing: 12px;
                    padding: 24px;

                    HorizontalLayout {
                        alignment: center;
                        Icon { glyph: Icons.archive; box: 34px; tint: Theme.ink-muted; }
                    }

                    Text {
                        text: root.problem == ""
                            ? "No hay nada apartado"
                            : "No se pudo leer lo que está apartado";
                        font-size: Theme.t-xl;
                        font-weight: 600;
                        color: Theme.ink;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: root.problem == ""
                            ? "Lo que resulte sospechoso aparecerá aquí, y podrás recuperarlo cuando quieras."
                            : root.problem;
                        font-size: Theme.t-md;
                        color: Theme.ink-muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
        }

        Text {
            text: root.items.length == 0
                ? "Apartar un archivo no lo borra: lo guarda Rhino para que no pueda hacer nada."
                : (root.items.length == 1
                    ? "1 archivo apartado. Nada se borra hasta que tú lo decidas."
                    : root.items.length + " archivos apartados. Nada se borra hasta que tú lo decidas.");
            font-size: Theme.t-sm;
            color: Theme.ink-muted;
            wrap: word-wrap;
        }
    }
}

// Historial: la tabla, sin adornos alrededor.
component HistoryScreen inherits Rectangle {
    in property <[HistoryItem]> items;
    in property <string> problem: "";

    VerticalLayout {
        padding: 28px;
        spacing: 0px;

        if root.items.length > 0 : HorizontalLayout {
            height: 32px;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 12px;

            Text { text: "Cuándo"; font-size: Theme.t-sm; color: Theme.ink-muted; width: 140px; vertical-alignment: center; }
            Text { text: "Qué se analizó"; font-size: Theme.t-sm; color: Theme.ink-muted; width: 230px; vertical-alignment: center; }
            Text { text: "Archivos"; font-size: Theme.t-sm; color: Theme.ink-muted; width: 72px; vertical-alignment: center; }
            Text { text: "Resultado"; font-size: Theme.t-sm; color: Theme.ink-muted; horizontal-stretch: 1; vertical-alignment: center; }
        }

        if root.items.length > 0 : Rule {}

        // Veinte entradas no caben en 680 px: la tabla se desplaza y el encabezado
        // se queda fijo arriba. El envoltorio se queda el sobrante y el Flickable
        // lo llena: un Flickable suelto en el layout mide lo que mide su contenido.
        if root.items.length > 0 : Rectangle {
            vertical-stretch: 1;

            scroll := Flickable {
                width: parent.width;
                height: parent.height;
                content-width: self.width;
                content-height: rows.preferred-height;
                interactive: true;

                rows := VerticalLayout {
                    width: scroll.width;
                    spacing: 0px;

                    for item[index] in root.items : Rectangle {
                        height: 46px;

                        Rectangle {
                            y: parent.height - 1px;
                            width: parent.width;
                            height: 1px;
                            background: Theme.rail-rule;
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 12px;

                            Text {
                                text: item.when;
                                font-size: Theme.t-md;
                                color: Theme.ink-soft;
                                width: 140px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: item.scope;
                                font-size: Theme.t-md;
                                color: Theme.ink-soft;
                                width: 230px;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                text: item.files;
                                font-size: Theme.t-md;
                                color: Theme.ink-muted;
                                width: 72px;
                                vertical-alignment: center;
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                horizontal-stretch: 1;

                                Mid {
                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: item.findings == 0 ? Theme.ok : Theme.danger;
                                    }
                                }

                                Text {
                                    text: item.findings == 0
                                        ? "Nada sospechoso"
                                        : (item.findings == 1 ? "1 sospechoso" : item.findings + " sospechosos");
                                    font-size: Theme.t-md;
                                    color: Theme.ink-soft;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }

        // El mismo estado vacío que el de «Poner a salvo», envuelto para que el
        // sobrante lo absorba el envoltorio y no la tarjeta (regla 17).
        if root.items.length == 0 : VerticalLayout {
            vertical-stretch: 1;
            alignment: center;

            Rectangle {
                background: Theme.card;
                border-radius: Theme.r-md;

                VerticalLayout {
                    alignment: center;
                    spacing: 12px;
                    padding: 24px;

                    HorizontalLayout {
                        alignment: center;
                        Icon { glyph: Icons.clock; box: 34px; tint: Theme.ink-muted; }
                    }

                    Text {
                        text: root.problem == ""
                            ? "Todavía no has analizado nada"
                            : "No se pudo leer el historial";
                        font-size: Theme.t-xl;
                        font-weight: 600;
                        color: Theme.ink;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: root.problem == ""
                            ? "Cuando termines un análisis, aparecerá aquí: qué se miró y qué se encontró."
                            : root.problem;
                        font-size: Theme.t-md;
                        color: Theme.ink-muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
        }

        VerticalLayout {
            padding-top: 12px;

            Text {
                text: "El historial no sale de tu equipo.";
                font-size: Theme.t-xs;
                color: Theme.ink-muted;
            }
        }
    }
}

// Ajustes: lo que se toca de vez en cuando, en tres bloques.
component SettingsScreen inherits Rectangle {
    in property <int> demo;
    in property <string> version;
    in property <string> core-status;
    callback go(int);

    VerticalLayout {
        // alignment: start para que los tres paneles tomen su alto natural: sin
        // esto el sobrante de la pantalla se reparte entre ellos y el hueco
        // interior de cada tarjeta crece.
        alignment: start;
        padding: 28px;
        spacing: 14px;

        Panel {
            title: "Protección";

            HorizontalLayout {
                spacing: 12px;

                Mid {
                    Rectangle {
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: root.demo == 3 ? Theme.warn : Theme.ok;
                    }
                }

                Text {
                    text: root.demo == 3
                        ? "Sin datos de protección"
                        : "Al día · actualizada hace 6 días";
                    font-size: Theme.t-md;
                    color: Theme.ink-soft;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }

                Mid {
                    AppButton {
                        width: 208px;
                        primary: root.demo == 3;
                        label: "Actualizar la protección";
                        clicked => { }
                    }
                }
            }
        }

        Panel {
            title: "Qué no debe mirar";

            Text {
                text: "Todavía no has añadido ninguna carpeta.";
                font-size: Theme.t-md;
                color: Theme.ink-muted;
            }

            Text {
                text: "Rhino deja en paz lo que añadas aquí. Sirve para tus ficheros de trabajo o tus propias herramientas.";
                font-size: Theme.t-sm;
                color: Theme.ink-muted;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 10px;

                AppButton { width: 176px; primary: false; glyph: Icons.folder-open; label: "Añadir carpeta"; clicked => { } }
                AppButton { width: 104px; primary: false; quiet: true; label: "Quitar"; enabled: false; clicked => { } }
            }
        }

        Panel {
            title: "Acerca de Rhino";

            Text { text: "Rhino " + root.version; font-size: Theme.t-md; color: Theme.ink; }

            Text {
                text: "Gratis, sin cuentas y sin enviar nada de tu equipo a ninguna parte. Consume poco y no interrumpe.";
                font-size: Theme.t-sm;
                color: Theme.ink-soft;
                wrap: word-wrap;
            }

            Text {
                text: "Iconos de Lucide (ISC), en parte de Feather (MIT). El estado del núcleo es: " + root.core-status;
                font-size: Theme.t-xs;
                color: Theme.ink-muted;
                wrap: word-wrap;
            }
        }
    }
}

// ── Ventana ───────────────────────────────────────────────────────────────────

export component MainWindow inherits Window {
    title: "Rhino";
    width: 980px;
    height: 680px;
    background: Theme.ground;

    // Un solo sitio donde se fija la tipografía: así ningún Text se queda con la
    // fuente del sistema ni con un tamaño suelto.
    default-font-family: "Inter";
    default-font-size: Theme.t-md;
    default-font-weight: 400;

    in property <string> version;
    in property <[FindingItem]> findings;
    in property <[SafeItem]> safe-items;
    in property <string> safe-problem: "";    // por qué no se pudo leer lo apartado
    in property <[HistoryItem]> history;
    in property <string> history-problem: ""; // por qué no se pudo leer el historial
    in property <int> scanned: 0;             // archivos ya analizados
    in property <int> failed: 0;              // carpetas y archivos que no se pudieron leer
    in property <string> current-file: "";    // el que se está analizando ahora
    in property <bool> has-database: false;
    in property <bool> has-scanned: false;    // hay algún análisis en el historial
    in property <string> last-scan: "";       // «hoy a las 21:14»
    in property <int> last-findings: 0;       // archivos con algo en la última revisión
    in property <bool> show-demo: false;
    in-out property <string> file-path;
    in-out property <string> status: "Listo";
    in-out property <bool> scanning: false;
    in-out property <int> screen: 0;
    in-out property <int> demo: 0;
    in-out property <int> scope: 0;           // 0 = todo el equipo, 1 = una carpeta, 2 = un archivo
    in-out property <int> expanded-row: -1;   // qué hallazgo tiene «Ver la comprobación» abierto

    callback scan-requested();
    callback pick-folder();
    callback pick-file();
    callback cancel-scan();
    callback quarantine(int);
    callback ignore(int);
    callback restore(int);
    callback erase(int);

    // El estado de Inicio sale de tres hechos del disco, en este orden: se está
    // analizando, falta la base de datos, y qué dejó la última revisión.
    property <bool> has-findings: root.findings.length > 0;
    property <bool> findings-reset: root.last-findings > 0 && !root.has-findings;
    property <string> reviewed: root.last-scan == "" ? "" : "Revisado " + root.last-scan + ". ";
    property <color> tone: root.scanning ? Theme.accent
        : (!root.has-database ? Theme.warn
        : (root.has-findings || root.findings-reset ? Theme.danger-fill
        : (!root.has-scanned ? Theme.accent : Theme.ok)));
    property <string> tone-glyph: root.scanning ? Icons.search
        : (!root.has-database ? Icons.alert
        : (root.has-findings || root.findings-reset ? Icons.shield-alert
        : (!root.has-scanned ? Icons.search : Icons.check)));
    property <string> headline: root.scanning
        ? "Analizando tu equipo"
        : (!root.has-database
            ? "Falta actualizar la protección"
            : (root.has-findings
                ? (root.findings.length == 1
                    ? "Hay 1 archivo que mirar"
                    : "Hay " + root.findings.length + " archivos que mirar")
                : (root.findings-reset
                    ? (root.last-findings == 1
                        ? "La última revisión encontró 1 archivo"
                        : "La última revisión encontró " + root.last-findings + " archivos")
                    : (!root.has-scanned
                        ? "Todavía no has mirado nada"
                        : "Tu equipo está en orden"))));
    property <string> message: root.scanning
        ? "Puedes seguir usando el equipo mientras analizamos."
        : (!root.has-database
            ? "Rhino aún no reconoce lo peligroso. Es una descarga de un momento."
            : (root.has-findings
                ? root.reviewed + "Rhino no ha tocado nada: decides tú."
                : (root.findings-reset
                    ? root.reviewed + "Analiza otra vez para revisarlos."
                    : (!root.has-scanned
                        ? "Un análisis completo tarda unos minutos y puedes seguir usando el equipo."
                        : root.reviewed + "No se encontró nada."))));
    property <string> action: root.scanning
        ? "Ver el progreso"
        : (!root.has-database
            ? "Actualizar la protección"
            : (root.has-findings
                ? "Ver los archivos"
                : (root.findings-reset || !root.has-scanned
                    ? "Analizar todo el equipo"
                    : "Analizar otra vez")));
    property <string> results-headline: root.findings.length == 0
        ? "Ningún archivo sospechoso"
        : (root.findings.length == 1
            ? "1 archivo sospechoso"
            : root.findings.length + " archivos sospechosos");
    // La insignia del riel es un círculo pequeño: un recuento de tres cifras no
    // cabe, así que a partir de nueve se resume.
    property <string> findings-badge: root.findings.length == 0 ? ""
        : (root.findings.length > 9 ? "9+" : "" + root.findings.length);

    HorizontalLayout {
        // ── Riel de navegación ──
        Rectangle {
            width: 264px;
            background: Theme.rail;

            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                height: parent.height;
                background: Theme.rail-rule;
            }

            VerticalLayout {
                padding-top: 18px;
                spacing: 0px;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-bottom: 20px;
                    spacing: 10px;

                    Mid {
                        Icon { glyph: Icons.shield-check; box: 20px; tint: Theme.ink; }
                    }

                    Text {
                        text: "Rhino";
                        font-size: Theme.t-xl;
                        font-weight: 700;
                        color: Theme.ink;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    spacing: 2px;

                    NavRow {
                        label: "Inicio";
                        glyph: Icons.home;
                        current: root.screen == 0;
                        clicked => { root.screen = 0; }
                    }
                    NavRow {
                        label: "Analizar";
                        glyph: Icons.scan-search;
                        current: root.screen == 1;
                        clicked => { root.screen = 1; }
                    }
                    NavRow {
                        label: "Archivos sospechosos";
                        glyph: Icons.shield-alert;
                        current: root.screen == 2;
                        badge: root.findings-badge;
                        clicked => { root.screen = 2; }
                    }
                    NavRow {
                        label: "Poner a salvo";
                        glyph: Icons.archive;
                        current: root.screen == 3;
                        clicked => { root.screen = 3; }
                    }
                    NavRow {
                        label: "Historial";
                        glyph: Icons.clock;
                        current: root.screen == 4;
                        clicked => { root.screen = 4; }
                    }
                    NavRow {
                        label: "Ajustes";
                        glyph: Icons.settings;
                        current: root.screen == 5;
                        clicked => { root.screen = 5; }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                // Tira de estados: es parte de la maqueta, no del producto, y solo
                // existe en las compilaciones de desarrollo.
                Rectangle {
                    visible: root.show-demo;
                    x: 12px;
                    width: parent.width - 24px;
                    background: #141A1E;
                    border-width: 1px;
                    border-color: #2A343A;
                    border-radius: Theme.r-sm;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 7px;

                        Text {
                            text: "MAQUETA · ESTADO";
                            font-size: Theme.t-xs;
                            font-weight: 700;
                            color: Theme.ink-muted;
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            for d in [0, 1] : Rectangle {
                                horizontal-stretch: 1;
                                height: 26px;
                                border-radius: 3px;
                                background: root.demo == d ? Theme.ink : Theme.card;

                                Text {
                                    text: d == 0 ? "En orden" : "Con hallazgos";
                                    font-size: Theme.t-xs;
                                    color: root.demo == d ? Theme.rail : Theme.ink-soft;
                                    width: parent.width;
                                    height: parent.height;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.demo = d; root.screen = d == 1 ? 2 : 0; }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            for d in [2, 3] : Rectangle {
                                horizontal-stretch: 1;
                                height: 26px;
                                border-radius: 3px;
                                background: root.demo == d ? Theme.ink : Theme.card;

                                Text {
                                    text: d == 2 ? "Analizando" : "Sin datos";
                                    font-size: Theme.t-xs;
                                    color: root.demo == d ? Theme.rail : Theme.ink-soft;
                                    width: parent.width;
                                    height: parent.height;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.demo = d; root.screen = d == 2 ? 1 : 0; }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── Área de trabajo ──
        // Ancho explícito: si se deja al tamaño implícito, la cadena de layouts
        // resuelve por contenido y el área colapsa a ~689 px de los 780 reales.
        Rectangle {
            width: parent.width - 264px;

            VerticalLayout {
                Rectangle {
                    width: parent.width;
                    height: 56px;

                    Rectangle {
                        x: 0;
                        y: parent.height - 1px;
                        width: parent.width;
                        height: 1px;
                        background: Theme.rail-rule;
                    }

                    Text {
                        x: 28px;
                        y: 16px;
                        text: root.screen == 0 ? "Inicio"
                            : (root.screen == 1 ? "Analizar"
                            : (root.screen == 2 ? "Archivos sospechosos"
                            : (root.screen == 3 ? "Poner a salvo"
                            : (root.screen == 4 ? "Historial" : "Ajustes"))));
                        font-size: Theme.t-xl;
                        font-weight: 600;
                        color: Theme.ink;
                    }
                }

                Rectangle {
                    width: parent.width;
                    vertical-stretch: 1;

                    HomeScreen {
                        visible: root.screen == 0;
                        width: parent.width;
                        height: parent.height;
                        headline: root.headline;
                        message: root.message;
                        tone: root.tone;
                        glyph: root.tone-glyph;
                        action: root.action;
                        act => {
                            if root.scanning { root.screen = 1; }
                            else if root.has-findings && root.has-database { root.screen = 2; }
                            else {
                                // «Analizar todo el equipo» empieza por el disco
                                // del sistema, aunque se hubiera elegido antes
                                // una carpeta o un archivo.
                                root.scope = 0;
                                root.scan-requested();
                            }
                        }
                    }

                    AnalyzeScreen {
                        visible: root.screen == 1;
                        width: parent.width;
                        height: parent.height;
                        scanning: root.scanning;
                        scanned: root.scanned;
                        failed: root.failed;
                        current-file: root.current-file;
                        chosen-path: root.file-path;
                        scope <=> root.scope;
                        scan-all => { root.scan-requested(); }
                        pick-folder => { root.pick-folder(); }
                        pick-file => { root.pick-file(); }
                        cancel-scan => { root.cancel-scan(); }
                    }

                    ResultsScreen {
                        visible: root.screen == 2;
                        width: parent.width;
                        height: parent.height;
                        findings: root.findings;
                        headline: root.results-headline;
                        expanded <=> root.expanded-row;
                        go(x) => { root.screen = x; }
                        quarantine(x) => { root.quarantine(x); }
                        ignore(x) => { root.ignore(x); }
                    }

                    SafeScreen {
                        visible: root.screen == 3;
                        width: parent.width;
                        height: parent.height;
                        items: root.safe-items;
                        problem: root.safe-problem;
                        go(x) => { root.screen = x; }
                        restore(x) => { root.restore(x); }
                        erase(x) => { root.erase(x); }
                    }

                    HistoryScreen {
                        visible: root.screen == 4;
                        width: parent.width;
                        height: parent.height;
                        items: root.history;
                        problem: root.history-problem;
                    }

                    SettingsScreen {
                        visible: root.screen == 5;
                        width: parent.width;
                        height: parent.height;
                        demo: root.demo;
                        version: root.version;
                        core-status: root.status;
                        go(x) => { root.screen = x; }
                    }
                }
            }
        }
    }
}
