[Unit]
Description=Rhino web de pruebas (127.0.0.1:27182)
After=network.target

[Service]
Type=simple
# %h es el directorio del usuario que instala la unidad; si el repositorio no
# vive en ~/Documentos/Dev/Rhino, cambia las dos rutas.
WorkingDirectory=%h/Documentos/Dev/Rhino/web/public
ExecStart=/usr/bin/python3 -m http.server 27182 --bind 127.0.0.1 --directory %h/Documentos/Dev/Rhino/web/public
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
